{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/home"
    },
    {
      "source": "/home",
      "destination": "/home/index.html"
    },
    {
      "source": "/Learn",
      "destination": "/Learn/index.html"
    },
    {
      "source": "/Order",
      "destination": "/Order/index.html"
    },
    {
      "source": "/Order/bulk",
      "destination": "/Order/bulk/index.html"
    },
    {
      "source": "/kiosk",
      "destination": "/kiosk.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/infographics.html",
      "destination": "/Learn",
      "permanent": true
    },
    {
      "source": "/order-form.html",
      "destination": "/Order",
      "permanent": true
    },
    {
      "source": "/bulk-order.html",
      "destination": "/Order/bulk",
      "permanent": true
    },
    {
      "source": "/kiosk.html",
      "destination": "/kiosk",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/swintech BRAND VIDEO eng FINAL W SUBS.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "video/mp4"
        }
      ]
    },
    {
      "source": "/swintech%20BRAND%20VIDEO%20eng%20FINAL%20W%20SUBS.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "video/mp4"
        }
      ]
    },
    {
      "source": "/demo video spray only VO engsubs FIOINAL.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "video/mp4"
        }
      ]
    },
    {
      "source": "/demo%20video%20spray%20only%20VO%20engsubs%20FIOINAL.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "video/mp4"
        }
      ]
    }
  ]
}
